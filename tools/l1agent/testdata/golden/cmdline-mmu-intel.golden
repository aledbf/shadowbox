vendor=intel
L1: loading intel from /mnt/payload/kvm-intel.ko 
insmod=[insmod][/mnt/payload/kvm-intel.ko]
mode=mmu suite=perf
test_timeout=300
L1: guest: 2 vcpus, 1G, timeout 1800s
append=console=ttyS0,115200 panic=-1 oops=panic pvmtest.suite=perf pvmtest.tag=intel-guest quiet loglevel=0 pvmtest.only=perf/syscall pvmtest.statsmsr=1
qemu=[timeout][-k][5][1800][/mnt/payload/perf][stat][-a][-o][/tmp/mmu.txt][-e][kvm:kvm_exit,kvm:kvm_entry,kvm:kvm_emulate_insn,kvm:kvm_pio,kvm:kvm_mmio,kvm:kvm_msr,kvm:kvm_hypercall,kvmmmu:kvm_mmu_get_page,kvmmmu:kvm_mmu_prepare_zap_page,kvmmmu:kvm_mmu_sync_page,kvmmmu:kvm_mmu_unsync_page,kvmmmu:fast_page_fault][--][qemu-system-x86_64][-machine][q35,accel=kvm][-cpu][host][-smp][2][-m][1G][-kernel][/mnt/payload/guest-vmlinux][-initrd][/mnt/payload/initrd.cpio.gz][-append][console=ttyS0,115200 panic=-1 oops=panic pvmtest.suite=perf pvmtest.tag=intel-guest quiet loglevel=0 pvmtest.only=perf/syscall pvmtest.statsmsr=1][-display][none][-monitor][none][-serial][file:/tmp/guest.log][-no-reboot]
