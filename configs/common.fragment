# Shared by the host and guest test kernels.
#
# Everything the harness needs has to be built in: there is no module
# loading in the guest initrd, and the host image is booted before any
# filesystem carrying modules is available.

CONFIG_64BIT=y
CONFIG_SMP=y

# Console.  The harness reads everything over ttyS0 and matches on it, so
# the console must be there from the first printk.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y

# Root.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# virtio, for anything the harness wants to hand in or take out.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# A boot failure that reboots is a boot failure the harness cannot read.
CONFIG_PANIC_TIMEOUT=-1

# Diagnostics.  These cost performance, so the perf configuration turns
# them back off; correctness runs want them.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FRAME_POINTER=y
